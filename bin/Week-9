class Paintbrush {

  String bristleType; 
  String handleColor; 

  int _paintLoad; 
  
  Paintbrush({
    required this.bristleType,
    required this.handleColor,
    int initialPaintLoad = 0,
  }) : _paintLoad = initialPaintLoad.clamp(0, 100);

  int get paintLoad => _paintLoad;

  void dipInPaint(int amount) {
    _paintLoad = (_paintLoad + amount).clamp(0, 100);
    print('Dipped $handleColor paintbrush ($bristleType). Current paint load: $_paintLoad%');
  }

  void applyStroke(String surface) {
    if (_paintLoad <= 0) {
      print('Cannot paint on $surface! The $handleColor brush is completely dry.');
      return;
    }

    _paintLoad = (_paintLoad - 25).clamp(0, 100);
    print('Applied stroke on $surface using $handleColor brush. Remaining paint load: $_paintLoad%');
  }

  void clean() {
    _paintLoad = 0;
    print('Cleaned $handleColor paintbrush. Paint load reset to $_paintLoad%.');
  }
}

void main() {
  print(' NATIONAL TEACHERS COLLEGE - PC16 OOP DART DEMO');

  Paintbrush brush1 = Paintbrush(
    bristleType: 'Synthetic',
    handleColor: 'Red',
    initialPaintLoad: 0,
  );

  Paintbrush brush2 = Paintbrush(
    bristleType: 'Animal Hair',
    handleColor: 'Natural Wood',
    initialPaintLoad: 50,
  );

  Paintbrush brush3 = Paintbrush(
    bristleType: 'Foam',
    handleColor: 'Blue',
    initialPaintLoad: 100,
  );

  List<Paintbrush> studioBrushes = [brush1, brush2, brush3];

  Map<String, Paintbrush> artistPalette = {
    'Detailing': brush1,
    'Watercolor': brush2,
    'Background': brush3,
  };

  print('--- TESTING OBJECT BEHAVIORS ---');

  studioBrushes[0].dipInPaint(80);
  studioBrushes[0].applyStroke('Canvas');
  studioBrushes[0].applyStroke('Canvas');
  studioBrushes[0].clean();

  print('\n--- TESTING MAP & ENCAPSULATED STATE ---');

  Paintbrush detailingBrush = artistPalette['Detailing']!;
  print('Detailing Brush Color: ${detailingBrush.handleColor}');
  print('Detailing Brush Paint Load (via getter): ${detailingBrush.paintLoad}%');

  print('\n--- ITERATING THROUGH LIST OF OBJECTS ---');
  for (int i = 0; i < studioBrushes.length; i++) {
    print('Brush #${i + 1}: ${studioBrushes[i].handleColor} (${studioBrushes[i].bristleType}) - Load: ${studioBrushes[i].paintLoad}%');
  }
}
